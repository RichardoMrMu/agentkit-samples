# Copy this file to `.env` in the customer_support directory and fill in the
# required credentials, knowledge base and one long-term memory backend below.
# This file is for running the agent locally — it is NOT uploaded to the runtime
# on `agentkit deploy`. Configure the required runtime environment variables
# separately when deploying.

# --- Volcengine credentials ---
# Set your AK/SK to run the agent locally — the model credential is derived from
# them automatically. On the AgentKit cloud runtime credentials are provided
# for you; the knowledge base and memory settings below are still required.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
# VOLCENGINE_REGION=cn-beijing

# --- Knowledge base (required) ---
# Required even when initializing a new knowledge base. Use the collection name,
# not its ID; it must start with a letter and contain only letters, digits and
# underscores (1-128 characters).
DATABASE_VIKING_COLLECTION=

# Required when the startup knowledge check fails or cannot find the sample
# content: files from pre_build/knowledge are uploaded through this TOS bucket.
# Can be omitted only when reusing a knowledge base that passes the check.
# BytePlus requires the bucket even when reusing an existing knowledge base.
DATABASE_TOS_BUCKET=

# --- Long-term memory (required: choose one backend) ---
# Option 1: Viking memory. Both values are required when not using Mem0.
# Use a memory collection name, separate from the knowledge base collection.
DATABASE_VIKINGMEM_COLLECTION=
# Comma-separated memory types matching the memory collection, for example:
# DATABASE_VIKINGMEM_MEMORY_TYPE=sys_event_v1,sys_profile_v1
DATABASE_VIKINGMEM_MEMORY_TYPE=

# Option 2: Mem0. Uncomment and fill BOTH values to use Mem0 instead of Viking.
# When both are set, Mem0 takes precedence and the Viking memory values above
# can be left empty.
# DATABASE_MEM0_BASE_URL=
# DATABASE_MEM0_API_KEY=

# --- BytePlus (optional alternative to Volcengine) ---
# Uncomment and fill the BytePlus credentials when running on BytePlus.
# CLOUD_PROVIDER also selects English prompts and pre_build/knowledge_en.
# CLOUD_PROVIDER=byteplus
# BYTEPLUS_ACCESS_KEY=
# BYTEPLUS_SECRET_KEY=
# BytePlus TOS defaults used by this sample; adjust to match your bucket.
# DATABASE_TOS_REGION=cn-hongkong
# DATABASE_TOS_ENDPOINT=tos-cn-hongkong.bytepluses.com

# --- Agent reasoning model (optional) ---
# You normally do NOT set these — the model credential comes from AK/SK above.
# Uncomment to pin a specific model/provider locally. Do NOT leave a placeholder
# value: a non-empty MODEL_AGENT_API_KEY overrides the automatic credential and
# will fail auth.
# MODEL_AGENT_PROVIDER=openai
# MODEL_AGENT_NAME=doubao-seed-1-6-250615
# MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/
# MODEL_AGENT_API_KEY=
